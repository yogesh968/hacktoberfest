# Copy this file to .env and adjust. No secrets are needed for local Ollama.

# Where Ollama is listening (default: this computer)
OLLAMA_BASE_URL=http://localhost:11434

# Any Ollama model tag. Tested: gemma3:4b. Smaller/faster: gemma3:1b. Apache-2.0 option: gemma4:e2b
# Avoid "*:cloud" tags if you want inference to stay on your machine.
OLLAMA_MODEL=gemma3:4b

# Seconds to wait for the model before giving up
OLLAMA_TIMEOUT_SECONDS=180

OLLAMA_TEMPERATURE=0.4

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
